# Public hostname you control DNS for. Do not invent one. Confirm DNS before
# pointing this at a real name. Compose fails if unset.
GATEWAY_DOMAIN=

# Let's Encrypt account email for Caddy ACME. Compose fails if unset.
GATEWAY_ACME_EMAIL=

# Public origin Matchmaker puts on session JSON (https:// + GATEWAY_DOMAIN).
# Copy the same value into matchmaker/.env as GATEWAY_PUBLIC_ORIGIN.
GATEWAY_PUBLIC_ORIGIN=

# Shared secret with Matchmaker GATEWAY_RESOLVE_TOKEN. ≥16 characters.
# Never commit the real value.
GATEWAY_RESOLVE_TOKEN=replace-with-a-long-random-gateway-resolve-token

# Matchmaker origin the gateway uses for POST /v1/gateway/resolve.
# Loopback if this VPS also runs Matchmaker; otherwise the private URL you use.
MATCHMAKER_URL=http://127.0.0.1:8000

# Headscale login-server (same as Host Agent HEADSCALE_LOGIN_SERVER).
HEADSCALE_LOGIN_SERVER=http://127.0.0.1:8080

# Preauth tagged tag:gateway (CLI, not the host or session mint routes).
#   docker compose exec headscale headscale preauthkeys create --user 1 --tags tag:gateway
# Never reuse a Host Agent, exit-node, or session guest/user preauth.
HEADSCALE_GATEWAY_AUTHKEY=replace-with-tag-gateway-preauth-from-headscale-cli

GATEWAY_FAIL_LIMIT=20
GATEWAY_FAIL_WINDOW_SECONDS=60
