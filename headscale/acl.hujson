// Default-deny Headscale policy for Distributed Compute Lab (phase 14c).
// Headscale 0.26.1 reads `acls`, not `grants`. An omitted `acls` key is not
// an allow-all here: this file always sets `acls` to the accepts below.
// Empty / missing policy.path (phase 14) allowed every node to talk.
//
// Operator user must be named `dcl` (`headscale users create dcl`). Policy
// usernames need a trailing `@` (`dcl@`); Headscale strips it when matching.
//
// Identities are tag-based. Matchmaker mints Host Agent nodes as `tag:host`
// (non-ephemeral). Each session mints one ephemeral preauth key tagged
// `tag:guest` for the VM, hostname `dcl-guest-<sessionId>`. The public
// HTTPS gateway joins as `tag:gateway` (operator server, CLI mint — not a
// volunteer host).
//
// Renters are NOT on the mesh. There is no `tag:user`. A renter reaches a
// desktop only through the gateway, which checks a per-session token. This
// is what keeps one renter away from another renter's desktop: Headscale
// 0.26 cannot express per-session rules, so a renter node could reach
// every guest.
//
// The gateway itself can still reach every guest; its scope is the
// per-session token. `tag:matchmaker` is reserved for a later
// control-plane node.
//
// Exact grants:
//   1. Matchmaker coordination: tag:host ↔ tag:matchmaker,
//      tag:guest ↔ tag:matchmaker
//   2. Public gateway ↔ VM: tag:gateway ↔ tag:guest
//   3. Host Agent → VM streamer health checks on KasmVNC/Sunshine ports.
//   4. Guest internet via platform exit nodes only:
//      tag:guest → tag:exit and tag:guest → autogroup:internet
// Not granted (and therefore denied):
//   - any renter device → anything (renters hold no mesh key)
//   - guest → host (no guest→host LAN / volunteer Tailscale IP)
//   - gateway → host, gateway → matchmaker, gateway → exit
//   - gateway → autogroup:internet (public HTTPS is the server NIC, not mesh)
//   - guest ↔ guest, host ↔ host, host → autogroup:internet
//   - volunteer hosts as exit nodes (autoApprovers.exitNode is tag:exit only)

{
  "groups": {
    "group:operators": ["dcl@"]
  },
  "tagOwners": {
    "tag:host": ["group:operators"],
    "tag:guest": ["group:operators"],
    "tag:matchmaker": ["group:operators"],
    "tag:exit": ["group:operators"],
    "tag:gateway": ["group:operators"]
  },
  "autoApprovers": {
    "exitNode": ["tag:exit"]
  },
  "acls": [
    {
      "action": "accept",
      "src": ["tag:host"],
      "dst": ["tag:matchmaker:*"]
    },
    {
      "action": "accept",
      "src": ["tag:matchmaker"],
      "dst": ["tag:host:*"]
    },
    {
      "action": "accept",
      "src": ["tag:guest"],
      "dst": ["tag:matchmaker:*"]
    },
    {
      "action": "accept",
      "src": ["tag:matchmaker"],
      "dst": ["tag:guest:*"]
    },
    {
      "action": "accept",
      "src": ["tag:gateway"],
      "dst": ["tag:guest:*"]
    },
    {
      "action": "accept",
      "src": ["tag:host"],
      "dst": ["tag:guest:8443", "tag:guest:47990"]
    },
    {
      "action": "accept",
      "src": ["tag:guest"],
      "dst": ["tag:gateway:*"]
    },
    {
      "action": "accept",
      "src": ["tag:guest"],
      "dst": ["tag:exit:*"]
    },
    {
      "action": "accept",
      "src": ["tag:guest"],
      "dst": ["autogroup:internet:*"]
    }
  ]
}
