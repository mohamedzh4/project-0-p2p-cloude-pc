# Public URL Tailscale clients pass as --login-server.
# Must match server_url in config.yaml (Headscale does not read this file).
# Compose fails to start if this is unset — same pattern as matchmaker/postgres.
HEADSCALE_SERVER_URL=http://127.0.0.1:8080
HEADSCALE_PORT=8080

# Only for the opt-in overlay docker-compose.exit-node.yml (not default up).
# Mint with: docker compose exec headscale headscale preauthkeys create --user 1 --tags tag:exit
# Never commit the real key. Never reuse a Host Agent preauth here.
HEADSCALE_EXIT_AUTHKEY=replace-with-tag-exit-preauth-from-headscale-cli
