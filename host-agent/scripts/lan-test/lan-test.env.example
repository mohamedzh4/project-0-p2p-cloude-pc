# Copy to lan-test.env. pack-lan-test-kit.sh fills this from
# guest-images/output/standard/env.snippet.

# Signed mode only: SHA-256 of the raw Standard guest disk (rootfs.img).
IMAGE_STANDARD_DIGEST=

# Where the guest disk comes from. Put rootfs.qcow2 next to the script, or:
# IMAGE_QCOW2_URL=https://example.com/rootfs.qcow2
# IMAGE_RAW_URL=https://example.com/rootfs.img

# Optional.
# LAN_TEST_PORT=8443
# VM size: asked at start when not set here (Enter = smallest working size).
# LAN_TEST_VCPUS=2              # min 1
# LAN_TEST_MEMORY_GIB=2         # min 2
# LAN_TEST_DISK_GIB=8           # quick mode, min 6; set higher to grow
# LAN_TEST_MODE=quick          # or signed (default: signed if a digest is set)
# LAN_TEST_SETUP_MINUTES=45     # quick mode first run
# LAN_TEST_BOOT_MINUTES=10      # every other run
