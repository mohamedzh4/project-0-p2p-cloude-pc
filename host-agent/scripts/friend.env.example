# The Host Agent fetches its commands from the server, so nothing here
# needs a port-forward or a tunnel. Only set HOST_AGENT_URL (and
# HOST_AGENT_LISTEN_ADDR) when the server can dial this PC directly.

# Optional. Direct https URL to Packer rootfs.qcow2 (~9 GiB).
# If unset, put rootfs.qcow2 in the same folder as setup.cmd.
IMAGE_QCOW2_URL=

# Optional. Direct https URL to the Windows NSIS installer.
# If unset, put host-agent-setup.exe in the same folder as setup.cmd.
HOST_AGENT_INSTALLER_URL=
