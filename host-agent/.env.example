# Origin of the Matchmaker API (scheme + host + optional port). Required to
# register and to send heartbeats. Do not include /v1 — the agent appends
# /v1/hosts, /v1/hosts/{id}/heartbeat, and /v1/hosts/{id}/earnings.
#
# Loopback is only correct when Matchmaker runs on THIS PC. A volunteer Linux
# or Windows host must point at the Matchmaker origin it can reach.
MATCHMAKER_URL=http://127.0.0.1:8000

# Same value as matchmaker/.env HOST_BOOTSTRAP_TOKEN. Required.
# Do not set HOST_APPROVE_TOKEN here. The agent cannot and must not self-approve.
HOST_BOOTSTRAP_TOKEN=replace-with-the-same-bootstrap-token-as-matchmaker

# Optional. Defaults to this machine's hostname (max 128 characters).
HOST_DISPLAY_NAME=

# Bind address for POST /v1/provision (Matchmaker calls this).
# `off` or empty disables the listener (UI-only machine).
# Volunteer hosts: bind 0.0.0.0:7842 so Matchmaker can connect from another
# machine. 0.0.0.0 is a bind address, NOT a destination — set HOST_AGENT_URL
# (LAN IP, DNS name, or Headscale hostname). Same-machine lab can use
# 127.0.0.1:7842 and omit HOST_AGENT_URL.
HOST_AGENT_LISTEN_ADDR=0.0.0.0:7842
# Origin advertised as agentUrl on register/update. Required when the listen
# address is 0.0.0.0 or [::] (fail fast). Example: http://192.0.2.10:7842
HOST_AGENT_URL=

# Optional. Absolute path to this dotenv file when the packaged app's cwd is
# not the folder you copied. If set, the file must exist (fail fast).
# HOST_AGENT_ENV_FILE=

# Required when HOST_AGENT_LISTEN_ADDR is set (fail fast). Ed25519 public key
# as 64 hex chars. Pins the platform image-signing key. Never a private key.
# Local-dev value verifies the fixture signatures in matchmaker/.env.example.
# After Packer, replace from guest-images/output/<tier>/env.snippet.
IMAGE_SIGNING_PUBLIC_KEY=7dadc44f5a3f883a46746bfdade30924db20fe6b43c8469733cfb007279d0da3
# SHA-256 hex of the standby image this host has (or the Standard fixture
# bytes `dcl-fixture-standard-v1\n` for local stub). Compared to the digest
# Matchmaker advertises before a stub boot. After Packer, copy IMAGE_STANDARD_DIGEST.
IMAGE_LOCAL_DIGEST=6ed707af13eb04a928001996ae5fc7a49ab405e73534caacf86ad65c51bab8fe
# Same IMAGE_* checksum metadata the Matchmaker advertises on GET /v1/images/{labTier}.
# Required to fetch+verify on Linux or Windows when Standard (and Linux Pro)
# are offered. Public values only — never a signing secret.
IMAGE_STANDARD_DIGEST=6ed707af13eb04a928001996ae5fc7a49ab405e73534caacf86ad65c51bab8fe
IMAGE_STANDARD_SIGNATURE=WQjS2zyW+BjgfoZDK3IFx6OIwXPmRxO22PN4FpfEJNpjY/AgEsLmqLVak99QZyY14YKNI5hiARiPkulHNpsrCQ==
IMAGE_PRO_DIGEST=b5dc04d095774efc8fee56dfcbabbe7346788f29a7576aaa27248d9b8249b118
IMAGE_PRO_SIGNATURE=T1FrV8mlhTvhk+0laH74qnb6s6CTM2M+waEhIAtjszKlN3pZyQ+w18xDfp0xvbA3MO+FXvt8Z+B+hmXDrvBaDA==

# Headscale login-server URL (phase 14, self-hosted — no Tailscale cloud).
# Required to join the mesh (fail fast). Omit to skip join after register
# (UI-only machines). The Matchmaker mints the preauth key; this agent never
# holds HEADSCALE_API_KEY. Never pass --advertise-exit-node; guest egress via
# a platform exit node is on the guest join plan (`HEADSCALE_EXIT_NODE`), never
# this Host Agent (see docs/runbooks/headscale.md).
# Volunteer hosts: this must be the Headscale origin the PC can reach, not
# loopback unless Headscale runs on this PC.
HEADSCALE_LOGIN_SERVER=http://127.0.0.1:8080
# Optional. Defaults to `tailscale` on PATH.
TAILSCALE_BIN=

# Guest rclone locators (phase 15, renterd S3 — not Storj). Public endpoint /
# bucket / prefix for a plan injected **inside the guest**. Do not rclone-mount
# on the volunteer host disk. Omit S3_ENDPOINT to skip the plan. Never put
# S3_ACCESS_KEY / S3_SECRET_KEY here — those belong in Matchmaker .env and in
# the guest only.
S3_ENDPOINT=
S3_BUCKET=lab-files
S3_PREFIX=
S3_REGION=us-east-1
S3_GUEST_MOUNT=/home/ubuntu/Persistent

# Bytes URL for the signed guest image (HTTP or file://). Matchmaker IMAGE_*
# is checksum metadata only — not a blob CDN. Required on Linux/Windows when
# Standard is offered (Pro URL required on Linux when Pro is offered). After
# Packer, point at guest-images/output/<tier>/rootfs.img (or a URL you host)
# and copy digest/signature from env.snippet. Empty/unset fails fetch (logged
# in the window); provision is then 400, not a fake disk.
# HOST_AGENT_STANDARD_IMAGE_URL=file:///var/lib/dcl/images/standard/rootfs.img
# HOST_AGENT_PRO_IMAGE_URL=file:///var/lib/dcl/images/pro/rootfs.img
# HOST_AGENT_IMAGE_CACHE=
# HOST_AGENT_IMAGE_MAX_BYTES=   # default 8GiB; tests use tiny fixtures
# HOST_AGENT_IMAGE_NETWORK=     # tests only: 1 allows non-loopback HTTP

# QEMU. Linux uses the distro qemu-system-x86_64 (install it with the package
# manager; nothing is downloaded). Windows installs the pinned Weilnetz NSIS
# installer (qemu-w64-setup-20260811.exe, published SHA-512) into the user
# cache with /S /D=<dir>; UAC is not suppressed. After a guest boots,
# provision polls KasmVNC on https://{guestMesh.hostname}:8443/ and returns
# that URL, or 400 if it never answers. Leave these unset in cargo test.
# HOST_AGENT_HYPERVISOR_CACHE=
# HOST_AGENT_QEMU_URL=           # pinned Weilnetz .exe (not the HTML index)
# HOST_AGENT_QEMU_SHA512=        # or HOST_AGENT_QEMU_SHA256 for fixtures
# HOST_AGENT_QEMU_VERSION=
# HOST_AGENT_QEMU_BIN=           # existing qemu-system-* binary (Linux: overrides /usr/bin; Windows: skips install)
# HOST_AGENT_HYPERVISOR_NETWORK= # tests only: 1 allows non-loopback HTTP

# Windows Pro GPU apply. VM must already exist and be powered off. The agent
# does not create or Start-VM that guest. Default name: dcl-pro-guest.
# HOST_AGENT_HYPERV_VM=dcl-pro-guest
# The window is plan-only. POST /v1/provision on Windows Pro applies DDA
# (preferred) or exclusive GPU-P through powershell.exe (tests inject a fake
# runner and never spawn PowerShell). After apply, provision polls Sunshine
# on https://{guestMesh.hostname}:47990/ and returns that URL, or 400 if it
# never answers. Linux Pro vfio-pci apply also runs on POST /v1/provision,
# not the window, then polls the same port.
