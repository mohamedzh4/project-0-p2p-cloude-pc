# Origin of the Matchmaker API (scheme + host + optional port). Required to
# register and to send heartbeats. Do not include /v1 — the agent appends
# /v1/hosts, /v1/hosts/{id}/heartbeat, and /v1/hosts/{id}/earnings.
MATCHMAKER_URL=http://127.0.0.1:8000

# Same value as matchmaker/.env HOST_BOOTSTRAP_TOKEN. Required.
# Do not set HOST_APPROVE_TOKEN here. The agent cannot and must not self-approve.
HOST_BOOTSTRAP_TOKEN=replace-with-the-same-bootstrap-token-as-matchmaker

# Optional. Defaults to this machine's hostname (max 128 characters).
HOST_DISPLAY_NAME=

# Optional. Bind address for POST /v1/provision (Matchmaker calls this).
# Omit to disable the listener. If set, HOST_BOOTSTRAP_TOKEN is required.
HOST_AGENT_LISTEN_ADDR=
# Optional. Origin advertised as agentUrl on register/update. Defaults to
# http://$HOST_AGENT_LISTEN_ADDR when the listen address is set.
HOST_AGENT_URL=

# Required when HOST_AGENT_LISTEN_ADDR is set (fail fast). Ed25519 public key
# as 64 hex chars. Pins the platform image-signing key. Never a private key.
# Local-dev value verifies the fixture signatures in matchmaker/.env.example.
IMAGE_SIGNING_PUBLIC_KEY=7dadc44f5a3f883a46746bfdade30924db20fe6b43c8469733cfb007279d0da3
# SHA-256 hex of the standby image this host has (or the Standard fixture
# bytes `dcl-fixture-standard-v1\n` for local stub). Compared to the digest
# Matchmaker advertises before a stub boot.
IMAGE_LOCAL_DIGEST=6ed707af13eb04a928001996ae5fc7a49ab405e73534caacf86ad65c51bab8fe
# Same IMAGE_* checksum metadata the Matchmaker advertises on GET /v1/images/{labTier}.
# Required to fetch+verify on Linux when Standard (and Pro) are offered. Public
# values only — never a signing secret.
IMAGE_STANDARD_DIGEST=6ed707af13eb04a928001996ae5fc7a49ab405e73534caacf86ad65c51bab8fe
IMAGE_STANDARD_SIGNATURE=WQjS2zyW+BjgfoZDK3IFx6OIwXPmRxO22PN4FpfEJNpjY/AgEsLmqLVak99QZyY14YKNI5hiARiPkulHNpsrCQ==
IMAGE_PRO_DIGEST=b5dc04d095774efc8fee56dfcbabbe7346788f29a7576aaa27248d9b8249b118
IMAGE_PRO_SIGNATURE=T1FrV8mlhTvhk+0laH74qnb6s6CTM2M+waEhIAtjszKlN3pZyQ+w18xDfp0xvbA3MO+FXvt8Z+B+hmXDrvBaDA==

# Headscale login-server URL (phase 14, self-hosted — no Tailscale cloud).
# Required to join the mesh (fail fast). Omit to skip join after register
# (UI-only machines). The Matchmaker mints the preauth key; this agent never
# holds HEADSCALE_API_KEY. Never pass --advertise-exit-node; guest egress via
# a platform exit node is on the guest join plan (`HEADSCALE_EXIT_NODE`), never
# this Host Agent (see docs/runbooks/headscale.md).
HEADSCALE_LOGIN_SERVER=http://127.0.0.1:8080
# Optional. Defaults to `tailscale` on PATH.
TAILSCALE_BIN=

# Guest rclone locators (phase 15, renterd S3 — not Storj). Public endpoint /
# bucket / prefix for a plan injected **inside the guest**. Do not rclone-mount
# on the volunteer host disk. Omit S3_ENDPOINT to skip the plan. Never put
# S3_ACCESS_KEY / S3_SECRET_KEY here — those belong in Matchmaker .env and in
# the guest only.
S3_ENDPOINT=
S3_BUCKET=lab-files
S3_PREFIX=
S3_REGION=us-east-1
S3_GUEST_MOUNT=/home/user/Persistent

# Optional hypervisor locate/fetch (phase 19 + 24). Defaults: Firecracker
# v1.16.1 GitHub tarball + published SHA-256; Windows QEMU Weilnetz NSIS
# installer (qemu-w64-setup-20260811.exe) + published SHA-512. Cache under
# the user cache dir (not /usr/bin). The webview does not fetch. Leave unset
# in cargo test. QEMU install argv is NSIS /S /D=<dir>; UAC is not suppressed.
# HOST_AGENT_HYPERVISOR_CACHE=
# HOST_AGENT_FIRECRACKER_URL=
# HOST_AGENT_FIRECRACKER_SHA256=
# HOST_AGENT_FIRECRACKER_VERSION=
# HOST_AGENT_FIRECRACKER_KIND=   # tar (default) or raw
# HOST_AGENT_QEMU_URL=           # pinned Weilnetz .exe (not the HTML index)
# HOST_AGENT_QEMU_SHA512=        # or HOST_AGENT_QEMU_SHA256 for fixtures
# HOST_AGENT_QEMU_VERSION=
# HOST_AGENT_QEMU_BIN=           # existing qemu-system-*.exe skips install
# HOST_AGENT_HYPERVISOR_NETWORK= # tests only: 1 allows non-loopback HTTP

# Optional guest-image locate/fetch (phase 20). Cache under the user cache dir
# (not a system path). Bytes URL is operator-supplied — Matchmaker IMAGE_* is
# checksum metadata only, not a blob CDN. The webview does not fetch. Leave
# unset in cargo test. Linux Standard fetches and verifies SHA-256 + Ed25519
# before the file is treated as ready. Windows logs would-fetch. macOS skips.
# HOST_AGENT_IMAGE_CACHE=
# HOST_AGENT_STANDARD_IMAGE_URL=
# HOST_AGENT_PRO_IMAGE_URL=
# HOST_AGENT_IMAGE_MAX_BYTES=   # default 8GiB; tests use tiny fixtures
# HOST_AGENT_IMAGE_NETWORK=     # tests only: 1 allows non-loopback HTTP
