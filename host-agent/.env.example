# Origin of the Matchmaker API (scheme + host + optional port). Required to
# register and to send heartbeats. Do not include /v1 — the agent appends
# /v1/hosts, /v1/hosts/{id}/heartbeat, and /v1/hosts/{id}/earnings.
MATCHMAKER_URL=http://127.0.0.1:8000

# Same value as matchmaker/.env HOST_BOOTSTRAP_TOKEN. Required.
# Do not set HOST_APPROVE_TOKEN here. The agent cannot and must not self-approve.
HOST_BOOTSTRAP_TOKEN=replace-with-the-same-bootstrap-token-as-matchmaker

# Optional. Defaults to this machine's hostname (max 128 characters).
HOST_DISPLAY_NAME=

# Optional. Bind address for POST /v1/provision (Matchmaker calls this).
# Omit to disable the listener. If set, HOST_BOOTSTRAP_TOKEN is required.
HOST_AGENT_LISTEN_ADDR=
# Optional. Origin advertised as agentUrl on register/update. Defaults to
# http://$HOST_AGENT_LISTEN_ADDR when the listen address is set.
HOST_AGENT_URL=

# Required when HOST_AGENT_LISTEN_ADDR is set (fail fast). Ed25519 public key
# as 64 hex chars. Pins the platform image-signing key. Never a private key.
# Local-dev value verifies the fixture signatures in matchmaker/.env.example.
IMAGE_SIGNING_PUBLIC_KEY=7dadc44f5a3f883a46746bfdade30924db20fe6b43c8469733cfb007279d0da3
# SHA-256 hex of the standby image this host has (or the Standard fixture
# bytes `dcl-fixture-standard-v1\n` for local stub). Compared to the digest
# Matchmaker advertises before a stub boot.
IMAGE_LOCAL_DIGEST=6ed707af13eb04a928001996ae5fc7a49ab405e73534caacf86ad65c51bab8fe

# Headscale login-server URL (phase 14, self-hosted — no Tailscale cloud).
# Required to join the mesh (fail fast). Omit to skip join after register
# (UI-only machines). The Matchmaker mints the preauth key; this agent never
# holds HEADSCALE_API_KEY. Never pass --advertise-exit-node; guest egress via
# a platform exit node is operator-manual (see docs/runbooks/headscale.md).
HEADSCALE_LOGIN_SERVER=http://127.0.0.1:8080
# Optional. Defaults to `tailscale` on PATH.
TAILSCALE_BIN=
