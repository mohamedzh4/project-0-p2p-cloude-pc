#cloud-config
users:
  - name: ubuntu
    groups: [adm, sudo, video, input, render]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}
ssh_pwauth: false
package_update: true
package_upgrade: false
runcmd:
  - [sh, -c, "growpart /dev/vda 1 2>/dev/null || true"]
  - [sh, -c, "resize2fs /dev/vda1 2>/dev/null || true"]
