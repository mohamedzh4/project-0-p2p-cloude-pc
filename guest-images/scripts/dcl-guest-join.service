[Unit]
Description=Distributed Compute Lab guest mesh join and persistent rclone
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/dcl-guest-join
ExecStop=/usr/local/sbin/dcl-guest-join --flush
TimeoutStartSec=300
# The stop step waits up to 75 s for rclone to finish uploading.
TimeoutStopSec=85

[Install]
WantedBy=multi-user.target
