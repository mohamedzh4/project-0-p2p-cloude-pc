# Pinned inputs for the guest-image pipeline. Packer downloads these at build
# time; they are not stored in git. Override with the same names in the
# environment if you already have local copies.

# Ubuntu 24.04 LTS cloud image (amd64). SHA-256 from
# https://cloud-images.ubuntu.com/releases/noble/release-20260911/SHA256SUMS
# Dated folder: the bare "release/" link moves and breaks the checksum.
UBUNTU_CLOUDIMG_URL=https://cloud-images.ubuntu.com/releases/noble/release-20260911/ubuntu-24.04-server-cloudimg-amd64.img
UBUNTU_CLOUDIMG_SHA256=612b2c0cc1bc413a6cb8c38fd611794caf0f2b436c50013d8b3794db12ad7354

# Ubuntu 24.04 LTS live-server ISO — only if you cannot use the cloud image.
# Leave unset for the default Packer disk_image path.
# UBUNTU_ISO_URL=https://releases.ubuntu.com/24.04/ubuntu-24.04.3-live-server-amd64.iso
# UBUNTU_ISO_SHA256=

# KasmVNC 1.3.4 for Ubuntu 24.04 Noble (direct browser desktop).
# https://github.com/kasmtech/KasmVNC/releases/tag/v1.3.4
KASM_VNC_DEB_URL=https://github.com/kasmtech/KasmVNC/releases/download/v1.3.4/kasmvncserver_noble_1.3.4_amd64.deb
KASM_VNC_DEB_SHA256=b222f104a839b1ec6ac4a28f5f2876463204e3c2ba3724a31c3fb59e1a780740

# Sunshine host streamer (Moonlight is the client). Official .deb name from
# https://docs.lizardbyte.dev/projects/sunshine/latest/md_docs_2getting__started.html
# GitHub "latest" keeps the stable asset name; do not use the AppImage (no KMS).
SUNSHINE_DEB_URL=https://github.com/LizardByte/Sunshine/releases/latest/download/sunshine-ubuntu-24.04-amd64.deb
