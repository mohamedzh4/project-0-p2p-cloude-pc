packer {
  required_version = ">= 1.10.0"
  required_plugins {
    qemu = {
      source  = "github.com/hashicorp/qemu"
      version = ">= 1.1.0"
    }
  }
}

variable "lab_tier" {
  type        = string
  description = "standard (Kasm in the guest) or pro (Sunshine in the guest)."
  validation {
    condition     = contains(["standard", "pro"], var.lab_tier)
    error_message = "The lab_tier value must be standard or pro."
  }
}

variable "cloud_image_url" {
  type        = string
  description = "Ubuntu 24.04 cloud image URL or local file:// / absolute path. Not committed."
}

variable "cloud_image_checksum" {
  type        = string
  description = "SHA-256 of the cloud image (sha256:<hex> or bare hex)."
}

variable "ssh_public_key" {
  type        = string
  description = "Throwaway SSH public key injected via cloud-init. Generated by build.sh."
}

variable "ssh_private_key_file" {
  type        = string
  description = "Matching private key Packer uses to SSH. Never commit."
}

variable "output_dir" {
  type        = string
  description = "Directory for this tier's qcow2 (under guest-images/output/<tier>)."
}

variable "accelerator" {
  type        = string
  description = "QEMU accelerator used only to *build* the image. Host Agent boot is a later phase."
  default     = "kvm"
}

variable "memory_mb" {
  type    = number
  default = 8192
}

variable "cpus" {
  type    = number
  default = 4
}

variable "disk_size" {
  type        = string
  description = "Guest disk. Ubuntu + XFCE + KasmVNC fit in 16G for the demo image."
  default     = "16G"
}

variable "kasm_vnc_deb_url" {
  type    = string
  default = ""
}

variable "kasm_vnc_deb_sha256" {
  type    = string
  default = ""
}

variable "sunshine_deb_url" {
  type    = string
  default = ""
}

variable "headless" {
  type    = bool
  default = true
}

locals {
  checksum = startswith(var.cloud_image_checksum, "sha256:") ? var.cloud_image_checksum : "sha256:${var.cloud_image_checksum}"
  streamer_script = var.lab_tier == "standard" ? "${path.root}/../scripts/provision-kasm.sh" : "${path.root}/../scripts/provision-sunshine.sh"
  vm_name         = "rootfs.qcow2"
}

source "qemu" "ubuntu" {
  iso_url              = var.cloud_image_url
  iso_checksum         = local.checksum
  disk_image           = true
  use_backing_file     = false
  format               = "qcow2"
  disk_size            = var.disk_size
  disk_interface       = "virtio"
  net_device           = "virtio-net"
  accelerator          = var.accelerator
  memory               = var.memory_mb
  cores                = var.cpus
  headless             = var.headless
  ssh_username         = "ubuntu"
  ssh_private_key_file = var.ssh_private_key_file
  ssh_timeout          = "30m"
  shutdown_command     = "sudo shutdown -P now"
  shutdown_timeout     = "5m"
  output_directory     = var.output_dir
  vm_name              = local.vm_name
  cd_label             = "cidata"
  cd_content = {
    "user-data" = templatefile("${path.root}/../cloud-init/user-data.pkrtpl", {
      ssh_public_key = var.ssh_public_key
    })
    "meta-data" = file("${path.root}/../cloud-init/meta-data")
  }
}

build {
  name    = "dcl-guest"
  sources = ["source.qemu.ubuntu"]

  provisioner "shell" {
    script          = "${path.root}/../scripts/provision-base.sh"
    execute_command = "chmod +x {{ .Path }}; sudo -n {{ .Vars }} {{ .Path }}"
    timeout         = "30m"
  }

  provisioner "file" {
    source      = "${path.root}/../scripts/dcl-guest-join.py"
    destination = "/tmp/dcl-guest-join.py"
  }

  provisioner "file" {
    source      = "${path.root}/../scripts/dcl-guest-join.service"
    destination = "/tmp/dcl-guest-join.service"
  }

  provisioner "shell" {
    execute_command = "chmod +x {{ .Path }}; sudo -n {{ .Vars }} {{ .Path }}"
    inline = [
      "install -m 0755 /tmp/dcl-guest-join.py /usr/local/sbin/dcl-guest-join",
      "install -m 0644 /tmp/dcl-guest-join.service /etc/systemd/system/dcl-guest-join.service",
      "systemctl enable dcl-guest-join.service",
    ]
  }

  provisioner "shell" {
    script          = local.streamer_script
    execute_command = "chmod +x {{ .Path }}; sudo -n {{ .Vars }} {{ .Path }}"
    timeout         = "2h"
    environment_vars = [
      "LAB_TIER=${var.lab_tier}",
      "KASM_VNC_DEB_URL=${var.kasm_vnc_deb_url}",
      "KASM_VNC_DEB_SHA256=${var.kasm_vnc_deb_sha256}",
      "SUNSHINE_DEB_URL=${var.sunshine_deb_url}",
    ]
  }
}
