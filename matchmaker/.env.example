POSTGRES_USER=matchmaker
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=matchmaker
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://matchmaker:replace-me@localhost:5432/matchmaker
TEST_DATABASE_URL=postgresql+psycopg://matchmaker:replace-me@localhost:5432/matchmaker_test

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

# Host Agent register/update (Bearer). Must differ from HOST_APPROVE_TOKEN.
HOST_BOOTSTRAP_TOKEN=replace-with-a-long-random-host-bootstrap-token
# Operator-only approve path (Bearer). Do not give this value to the Host Agent.
HOST_APPROVE_TOKEN=replace-with-a-long-random-host-approve-token
# Optional. Fallback origin if the booked host has no agentUrl (http/https, no path).
# Seeded kasmUrl is still used when this is empty and the agent is unreachable.
HOST_AGENT_PROVISION_URL=

# Internal ledger rate. Required. Integer credits billed per whole minute
# (rounded up; a zero-length session is 0). Not a payment-processor key.
CREDITS_PER_MINUTE=1
# How often the Matchmaker sweeps occupied silent hosts (seconds). 0 disables
# the background loop; book, history, and heartbeat paths still reclaim.
STALE_SESSION_SWEEP_INTERVAL_SECONDS=15

SEED_HOST_DISPLAY_NAME=phase1-lab-1
SEED_HOST_KASM_URL=https://example.invalid/kasm
SEED_HOST_KASM_TOKEN=
SEED_HOST_AGENT_URL=
SEED_HOST_SHARED_LOGICAL_CORES=4
SEED_HOST_SHARED_MEMORY_BYTES=8589934592
SEED_HOST_SHARE_GPU=false
SEED_HOST_SHARED_GPU_ID=

# Signed base-image metadata advertised to the Host Agent (FR9 image slice).
# Digests are SHA-256 hex. Signatures are Ed25519 over the raw 32-byte digest.
# The values below match the Host Agent local-dev public key and tiny fixture
# bytes (`dcl-fixture-standard-v1\n` / `dcl-fixture-pro-v1\n`). After a real
# Packer build, replace them from guest-images/output/<tier>/env.snippet.
# Do not put a private signing key here.
IMAGE_STANDARD_DIGEST=e72e4f2b382bd4805b83ac25c85dee8a409540394ff38231f7bb0d2935865756
IMAGE_STANDARD_SIGNATURE=uVdKqI2EzwJF7EBPSv0fvnlNa02bSQmfbQTABAchnyyg4rAerd6Gvpz9J+tpT867hJZT98X2ql0K05KrwBEKBA==
IMAGE_PRO_DIGEST=b5dc04d095774efc8fee56dfcbabbe7346788f29a7576aaa27248d9b8249b118
IMAGE_PRO_SIGNATURE=T1FrV8mlhTvhk+0laH74qnb6s6CTM2M+waEhIAtjszKlN3pZyQ+w18xDfp0xvbA3MO+FXvt8Z+B+hmXDrvBaDA==

# Self-hosted Headscale (phase 14). No Tailscale cloud account.
# HEADSCALE_URL is the Matchmaker → Headscale API origin.
# HEADSCALE_LOGIN_SERVER is what Host Agents pass to `tailscale up --login-server`.
# HEADSCALE_USER is the Headscale user id (numeric on Headscale 0.26.1). Create with
# `docker compose exec headscale headscale users create dcl` then `users list`.
# The ACL file expects that username (`dcl@`). HEADSCALE_API_KEY from
# `headscale apikeys create`. Never commit the real value.
# Host mint is tagged tag:host. Session book mints ephemeral tag:guest + tag:user.
# HEADSCALE_EXIT_NODE is the platform exit hostname/IP guests pass to
# `tailscale up --exit-node` (default: overlay TS_HOSTNAME dcl-platform-exit).
# Set to `off` to omit --exit-node from guest join plans (§9 item 5 not applied).
# Host Agent join never uses this value. Exit-node *advertise* keys are CLI-only.
HEADSCALE_URL=http://127.0.0.1:8080
HEADSCALE_LOGIN_SERVER=http://127.0.0.1:8080
HEADSCALE_API_KEY=replace-with-headscale-apikeys-create-output
HEADSCALE_USER=1
HEADSCALE_EXIT_NODE=dcl-platform-exit

# Public HTTPS gateway (phase 35). Unset keeps session JSON on the mesh locator
# (local lab / pytest). Production zero-install Standard Lab needs both:
# GATEWAY_PUBLIC_ORIGIN (https:// + a domain you control DNS for — do not invent)
# and GATEWAY_RESOLVE_TOKEN (same value as gateway/.env, ≥16 chars).
# Session connection URLs then become https://<origin>/s/<token>/ .
# Moonlight host stays the mesh hostname (Pro native client is not browser-only).
GATEWAY_PUBLIC_ORIGIN=
GATEWAY_RESOLVE_TOKEN=
GATEWAY_TOKEN_TTL_SECONDS=43200

# Origin guests call for POST /v1/guest/bootstrap (phase 34). Unset omits
# bootstrapOrigin from the provision hint — the guest image then cannot join.
# http is allowed (lab compose / TAP). Do not invent a domain.
MATCHMAKER_PUBLIC_ORIGIN=

# Storage for renters' files: any S3-compatible store.
# Primary names are S3_*. RENTERD_S3_* aliases are also accepted.
# S3_GUEST_ENDPOINT is what guests rclone (defaults to S3_ENDPOINT).
# Never commit real storage secrets. Pytest never calls a live store.
#
# Production: Cloudflare R2 with per-user temporary keys.
#   STORAGE_CREDENTIALS=r2
#   S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_ACCESS_KEY / S3_SECRET_KEY = an R2 API token's S3 key pair
#   S3_BUCKET=<one existing bucket; each user gets users/<id>/files/>
#   R2_ACCOUNT_ID=<account id>
#   R2_API_TOKEN=  (optional. Empty: the Matchmaker signs each guest's key
#     itself with the S3 key above. Set: it asks the Cloudflare API instead.)
#
# Development (below): a local renterd or MinIO. STORAGE_CREDENTIALS=static
# hands EVERY guest this same key, so never use it with real volunteers.
# Without S3_BUCKET each user gets a bucket dcl-<uuid>.
STORAGE_CREDENTIALS=static
S3_ENDPOINT=http://127.0.0.1:8081
S3_GUEST_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=replacewith16charkey
S3_SECRET_KEY=replace-with-s3-secret-at-least-16
S3_BUCKET=
R2_ACCOUNT_ID=
R2_API_TOKEN=
# A user above this many GB gets a read-only mount.
STORAGE_QUOTA_GB=20
# Lifetime of a guest's storage key. R2 cannot revoke one early.
STORAGE_CREDENTIAL_TTL_SECONDS=43200

# A booking still "provisioning" after this long is marked failed.
PROVISION_TIMEOUT_SECONDS=420

# Setup kits on the website ("Share my PC"). A kit is offered only when the
# public key, the disk and that OS's installer link are set. The kit holds a
# single-use registration code, never HOST_BOOTSTRAP_TOKEN. The links must be
# public downloads (for example GitHub Release assets); the agent verifies the
# disk with IMAGE_SIGNING_PUBLIC_KEY.
IMAGE_SIGNING_PUBLIC_KEY=
HOST_KIT_QCOW2_URL=
HOST_KIT_WINDOWS_INSTALLER_URL=
HOST_KIT_DEB_URL=
HOST_KIT_APPIMAGE_URL=
# Defaults to host-agent/scripts in this repository.
HOST_KIT_SCRIPTS_DIR=
