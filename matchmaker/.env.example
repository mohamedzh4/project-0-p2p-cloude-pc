POSTGRES_USER=matchmaker
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=matchmaker
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://matchmaker:replace-me@localhost:5432/matchmaker
TEST_DATABASE_URL=postgresql+psycopg://matchmaker:replace-me@localhost:5432/matchmaker_test

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

# Host Agent register/update (Bearer). Must differ from HOST_APPROVE_TOKEN.
HOST_BOOTSTRAP_TOKEN=replace-with-a-long-random-host-bootstrap-token
# Operator-only approve path (Bearer). Do not give this value to the Host Agent.
HOST_APPROVE_TOKEN=replace-with-a-long-random-host-approve-token

SEED_HOST_DISPLAY_NAME=phase1-lab-1
SEED_HOST_KASM_URL=https://example.invalid/kasm
SEED_HOST_KASM_TOKEN=
SEED_HOST_SHARED_LOGICAL_CORES=4
SEED_HOST_SHARED_MEMORY_BYTES=8589934592
SEED_HOST_SHARE_GPU=false
SEED_HOST_SHARED_GPU_ID=
