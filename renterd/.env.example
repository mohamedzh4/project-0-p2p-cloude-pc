# Wallet seed from `docker compose run --rm -it renterd config` (type `seed`).
# Never commit a real seed. Compose fails if this is unset.
RENTERD_SEED=replace-with-twelve-word-seed-from-renterd-config

# Admin / HTTP API password for the renterd UI on :9980. Never commit the real
# value. Not the S3 access key — create S3 v4 keypairs after boot (runbook).
RENTERD_API_PASSWORD=replace-with-a-long-random-renterd-api-password

# zen = Sia testnet. Do not set mainnet from CI. Operator compose only.
# Mainnet is a funded-wallet decision — see docs/runbooks/sia-mainnet.md.
RENTERD_NETWORK=zen

# Host ports (loopback). S3 is 8081 so Headscale can keep 8080.
RENTERD_API_PORT=9980
RENTERD_S3_PORT=8081
RENTERD_GATEWAY_PORT=9981

# S3 SigV4 pair is NOT compose env. After first boot, PUT it via the bus API
# (docs/runbooks/renterd.md) and copy the same values into matchmaker/.env.
# RENTERD_S3_ACCESS_KEY=replacewith16charkey
# RENTERD_S3_SECRET_KEY=replace-with-renterd-s3-secret-at-least-16

